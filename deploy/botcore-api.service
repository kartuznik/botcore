[Unit]
Description=botcore HTTP API (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bots/botcore
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/bots/botcore/.venv/bin/python -m api
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
