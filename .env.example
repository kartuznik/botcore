# ============================================================
# botcore — пример конфигурации. Скопируйте в .env и заполните.
# Файл .env в git не попадает (см. .gitignore).
# ============================================================

# --- Обязательное -------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=

# --- Необязательное -----------------------------------------
# Список включённых модулей через запятую.
# health регистрирует обработчик «неизвестной команды», поэтому держите его последним.
MODULES=raffle,health

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Файл SQLite: и для SqliteStorage ядра, и для таблиц модуля raffle
STORAGE_PATH=data/botcore.db

# --- Модуль raffle ------------------------------------------
# Telegram id администратора розыгрышей; можно несколько через запятую.
# Если пусто — модуль не поднимается, бот работает без него.
RAFFLE_ADMIN_ID=
