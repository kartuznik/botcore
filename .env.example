# ============================================================
# botcore — пример конфигурации. Скопируйте в .env и заполните.
# Файл .env в git не попадает (см. .gitignore).
# ============================================================

# --- Обязательное -------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=

# --- Необязательное -----------------------------------------
# Список включённых модулей через запятую.
# health регистрирует обработчик «неизвестной команды», поэтому держите его последним.
MODULES=raffle,health

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Файл SQLite: и для SqliteStorage ядра, и для таблиц модуля raffle
STORAGE_PATH=data/botcore.db

# --- Модуль raffle ------------------------------------------
# Telegram id администратора розыгрышей; можно несколько через запятую.
# Если пусто — модуль не поднимается, бот работает без него.
RAFFLE_ADMIN_ID=

# Как часто бот проверяет базу на розыгрыши, созданные через API (секунды, минимум 1)
RAFFLE_WATCH_INTERVAL=10

# --- API (процесс botcore-api) ------------------------------
# Секрет для подписи JWT. Без него API не стартует.
# Сгенерировать: python -c 'import secrets; print(secrets.token_urlsafe(48))'
API_JWT_SECRET=

# Интерфейс и порт HTTP-сервера. По умолчанию только localhost:
# наружу выставляйте через reverse proxy с TLS.
API_HOST=127.0.0.1
API_PORT=8020

# true — /auth/register открыт для всех; false — только первый аккаунт.
# После создания админа поставьте false.
API_REGISTRATION_OPEN=true
