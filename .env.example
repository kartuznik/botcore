# ============================================================
# botcore — пример конфигурации. Скопируйте в .env и заполните.
# Файл .env в git не попадает (см. .gitignore).
# ============================================================

# --- Обязательное -------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=

# --- Необязательное -----------------------------------------
# Список включённых модулей через запятую
MODULES=health

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Файл SQLite для SqliteStorage
STORAGE_PATH=data/botcore.db
